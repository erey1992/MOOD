        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/mood_background</item>
        <!-- Pantalla de arranque del sistema (Android 12+): el orbe sobre el azul del icono; después entra la intro animada. -->
